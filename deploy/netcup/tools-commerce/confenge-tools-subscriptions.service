[Unit]
Description=CONFENGE tools subscription financial reconciliation
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/confenge-web/current
OnFailure=confenge-tools-subscriptions-alert.service

[Service]
Type=oneshot
User=confenge-deploy
Group=confenge-web
WorkingDirectory=/opt/confenge-web/current
Environment=NODE_ENV=production
Environment=RUNTIME_PROFILE=netcup-production
EnvironmentFile=/etc/confenge-web/runtime.env
RuntimeDirectory=confenge-tools-commerce
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/confenge-tools-commerce/sweep.lock /usr/bin/env node runtime/tools-commerce/ops.cjs subscriptions-sweep
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
