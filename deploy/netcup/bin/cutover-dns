#!/usr/bin/env python3
"""Move only the public web records of confenge.com.br between hosts.

DNS is the one step of this cutover that is globally visible and not
transactional, so it is scripted rather than typed: the blast radius is declared
in code, the before-state is captured as the rollback plan, and everything the
zone holds that is not the public web surface is refused rather than trusted.

Explicitly out of scope, and asserted as such at runtime: api, ops and auth.ops
(other services on the same host), MX, SPF, DKIM, DMARC and every other mail
record. A cutover that quietly rewrites a DKIM record is worse than one that
does not happen.

  cutover-dns inventory
  cutover-dns plan    --to netcup|netlify
  cutover-dns apply   --to netcup|netlify --confirm
  cutover-dns verify  --to netcup|netlify

The API token is read from CF_API_TOKEN or --token-file; it is never printed,
logged or written to the evidence file.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

API = "https://api.cloudflare.com/client/v4"
ZONE_NAME = "confenge.com.br"

# The complete public web surface. Nothing outside this set is ever written.
PUBLIC_WEB_NAMES = ("confenge.com.br", "www.confenge.com.br")

# Names that share this zone and must survive the cutover untouched. Listed so a
# mistake is a loud assertion instead of a silent overwrite.
PROTECTED_NAMES = (
    "api.confenge.com.br",
    "ops.confenge.com.br",
    "auth.ops.confenge.com.br",
    "send.confenge.com.br",
    "autoconfig.confenge.com.br",
    "autodiscover.confenge.com.br",
)
PROTECTED_TYPES = ("MX", "TXT", "SRV", "CAA", "NS", "SOA")

# DNS-only records keep an explicit five-minute TTL so a rollback reaches
# resolvers quickly. Proxied records must use Cloudflare's automatic TTL (`1`)
# because visitors resolve Cloudflare anycast addresses rather than the origin.
CUTOVER_TTL = 300
PROXIED_TTL = 1

TARGETS: dict[str, dict[str, Any]] = {
    "netcup": {
        "confenge.com.br": [
            {
                "type": "A",
                "content": "159.195.18.88",
                "ttl": PROXIED_TTL,
                "proxied": True,
            }
        ],
        # www remains a single hop to the apex at the origin, while Cloudflare
        # proxies and flattens the public CNAME at the edge.
        "www.confenge.com.br": [
            {
                "type": "CNAME",
                "content": "confenge.com.br",
                "ttl": PROXIED_TTL,
                "proxied": True,
            }
        ],
    },
    "netlify": {
        "confenge.com.br": [
            {
                "type": "A",
                "content": "75.2.60.5",
                "ttl": CUTOVER_TTL,
                "proxied": False,
            },
            {
                "type": "A",
                "content": "99.83.231.61",
                "ttl": CUTOVER_TTL,
                "proxied": False,
            },
        ],
        "www.confenge.com.br": [
            {
                "type": "CNAME",
                "content": "confenge.netlify.app",
                "ttl": CUTOVER_TTL,
                "proxied": False,
            }
        ],
    },
}


class CutoverError(RuntimeError):
    """Refused before any record was written."""


def _token(args: argparse.Namespace) -> str:
    if args.token_file:
        token = Path(args.token_file).read_text(encoding="utf-8").strip()
    else:
        token = os.environ.get("CF_API_TOKEN", "").strip()
    if not token:
        raise CutoverError("CF_API_TOKEN or --token-file is required")
    return token


def _call(token: str, method: str, path: str, payload: dict | None = None) -> dict:
    request = urllib.request.Request(
        f"{API}{path}",
        method=method,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = json.load(response)
    except urllib.error.HTTPError as exc:
        raise CutoverError(f"{method} {path} failed: HTTP {exc.code} {exc.read()[:300].decode()}") from exc
    if not body.get("success"):
        raise CutoverError(f"{method} {path} refused: {body.get('errors')}")
    return body


def zone_id(token: str) -> str:
    result = _call(token, "GET", f"/zones?name={ZONE_NAME}")["result"]
    if len(result) != 1:
        raise CutoverError(f"expected exactly one zone named {ZONE_NAME}, found {len(result)}")
    return result[0]["id"]


def records(token: str, zone: str) -> list[dict]:
    out: list[dict] = []
    page = 1
    while True:
        body = _call(token, "GET", f"/zones/{zone}/dns_records?per_page=100&page={page}")
        out.extend(body["result"])
        info = body.get("result_info") or {}
        if page >= int(info.get("total_pages") or 1):
            return out
        page += 1


def _slim(record: dict) -> dict:
    value = {
        "id": record["id"],
        "type": record["type"],
        "name": record["name"],
        "content": record["content"],
        "ttl": record["ttl"],
        "proxied": record.get("proxied", False),
    }
    # These fields carry the effective contract for MX/SRV-style records and
    # must be part of a protected before/after comparison when Cloudflare
    # returns them. Volatile API metadata and timestamps are deliberately not.
    for field in ("priority", "data"):
        if field in record:
            value[field] = record[field]
    return value


def _record_identity(record: dict) -> tuple[str, str]:
    """Return the DNS value identity, independent of edge delivery state."""
    return record["type"], record["content"].rstrip(".")


def _record_contract(record: dict) -> tuple[str, str, bool, int]:
    """Return every public DNS field that must converge to the target."""
    return (
        *_record_identity(record),
        bool(record.get("proxied", False)),
        int(record.get("ttl") or 0),
    )


def _protected_snapshot(current: list[dict]) -> list[dict]:
    """Return every record the public-web cutover is forbidden to change."""
    protected = [
        _slim(record)
        for record in current
        if not (
            record["name"] in PUBLIC_WEB_NAMES
            and record["type"] in ("A", "AAAA", "CNAME")
        )
    ]
    return sorted(
        protected,
        key=lambda record: (
            record["name"],
            record["type"],
            record["content"],
            record["id"],
        ),
    )


def build_plan(current: list[dict], destination: str) -> dict[str, Any]:
    if destination not in TARGETS:
        raise CutoverError(f"unknown destination {destination!r}")
    target = TARGETS[destination]
    # A target naming anything outside the public web surface must fail, not be
    # quietly skipped: silently ignoring a declared record would leave the
    # operator believing a name was moved when it never was.
    if set(target) != set(PUBLIC_WEB_NAMES):
        extra = sorted(set(target) - set(PUBLIC_WEB_NAMES))
        missing = sorted(set(PUBLIC_WEB_NAMES) - set(target))
        raise CutoverError(
            f"refusing: destination {destination!r} is not the public web surface "
            f"(unexpected={extra} missing={missing})"
        )

    desired_ttls = {int(want["ttl"]) for records_for_name in target.values() for want in records_for_name}
    desired_proxy_states = {
        bool(want["proxied"])
        for records_for_name in target.values()
        for want in records_for_name
    }
    if len(desired_ttls) != 1 or len(desired_proxy_states) != 1:
        raise CutoverError(f"refusing: destination {destination!r} has inconsistent edge policy")

    protected = _protected_snapshot(current)

    deletes: list[dict] = []
    creates: list[dict] = []
    updates: list[dict] = []
    for name in PUBLIC_WEB_NAMES:
        existing = [r for r in current if r["name"] == name and r["type"] in ("A", "AAAA", "CNAME")]
        wanted = target[name]
        # Proxy state and TTL are part of the desired record. If only either of
        # those fields drifted, update the existing record in place rather than
        # briefly creating a duplicate or exposing the origin during a delete.
        remaining = list(existing)
        missing = []
        for want in wanted:
            exact = next(
                (r for r in remaining if _record_contract(r) == _record_contract(want)),
                None,
            )
            if exact:
                remaining.remove(exact)
                continue
            same_value = next(
                (r for r in remaining if _record_identity(r) == _record_identity(want)),
                None,
            )
            if same_value:
                updates.append({"id": same_value["id"], "name": name, **want})
                remaining.remove(same_value)
                continue
            missing.append(want)
        surplus = remaining

        # A name that holds a CNAME can hold nothing else, so create-then-delete
        # is impossible there: Cloudflare rejects the create with code 81053 and
        # the plan aborts having already rewritten the apex, leaving the zone
        # split between two hosts. Replace in place instead, which is also
        # atomic from a resolver's point of view.
        singleton = any(want["type"] == "CNAME" for want in wanted) or any(
            r["type"] == "CNAME" for r in surplus
        )
        if singleton and missing and surplus:
            updates.append({"id": surplus[0]["id"], "name": name, **missing.pop(0)})
            surplus = surplus[1:]
        creates.extend({"name": name, **want} for want in missing)
        deletes.extend(_slim(r) for r in surplus)

    # Assert the blast radius on the computed plan, not on the inventory. The
    # apex legitimately carries MX and SPF alongside its A records; what must be
    # impossible is a plan that writes them. Checking the inventory instead
    # refused every cutover for the mail records it was meant to protect.
    for row in [*deletes, *creates, *updates]:
        if row["name"] not in PUBLIC_WEB_NAMES:
            raise CutoverError(f"refusing: plan touches {row['name']}, which is not the public web surface")
        if row["type"] not in ("A", "AAAA", "CNAME"):
            raise CutoverError(f"refusing: plan touches a {row['type']} record on {row['name']}")

    return {
        "schema": "confenge.dns_cutover_plan/v1",
        "zone": ZONE_NAME,
        "destination": destination,
        "ttl": next(iter(desired_ttls)),
        "proxied": next(iter(desired_proxy_states)),
        "delete": deletes,
        "create": creates,
        "update": updates,
        "rollback": {
            "restore": [_slim(r) for r in current if r["name"] in PUBLIC_WEB_NAMES and r["type"] in ("A", "AAAA", "CNAME")],
            "command": f"cutover-dns apply --to {'netlify' if destination == 'netcup' else 'netcup'} --confirm",
        },
        "untouched": sorted({r["name"] + "/" + r["type"] for r in protected}),
    }


def apply_plan(token: str, zone: str, plan: dict) -> dict:
    applied: dict[str, list] = {"created": [], "updated": [], "deleted": []}
    # In-place replacements first: they are the ones that cannot be expressed as
    # create-then-delete, and each one leaves the name answered throughout.
    for want in plan.get("update", []):
        body = _call(
            token,
            "PUT",
            f"/zones/{zone}/dns_records/{want['id']}",
            {
                "type": want["type"],
                "name": want["name"],
                "content": want["content"],
                "ttl": want["ttl"],
                "proxied": want["proxied"],
            },
        )
        applied["updated"].append(_slim(body["result"]))
    # Create before delete: an overlapping moment is far safer than a gap with
    # no answer at all for the apex.
    for want in plan["create"]:
        body = _call(
            token,
            "POST",
            f"/zones/{zone}/dns_records",
            {
                "type": want["type"],
                "name": want["name"],
                "content": want["content"],
                "ttl": want["ttl"],
                "proxied": want["proxied"],
            },
        )
        applied["created"].append(_slim(body["result"]))
    for old in plan["delete"]:
        _call(token, "DELETE", f"/zones/{zone}/dns_records/{old['id']}")
        applied["deleted"].append(old)
    return applied


def verify(
    token: str,
    zone: str,
    destination: str,
    expected_protected: list[dict] | None = None,
) -> dict:
    target = TARGETS[destination]
    current = records(token, zone)
    problems: list[str] = []
    for name in PUBLIC_WEB_NAMES:
        have = sorted(
            _record_contract(r)
            for r in current
            if r["name"] == name and r["type"] in ("A", "AAAA", "CNAME")
        )
        want = sorted(_record_contract(w) for w in target[name])
        if have != want:
            problems.append(f"{name}: have={have} want={want}")
    protected_unchanged: bool | None = None
    if expected_protected is not None:
        before = _protected_snapshot(expected_protected)
        after = _protected_snapshot(current)
        protected_unchanged = before == after
        if not protected_unchanged:
            before_by_id = {record["id"]: record for record in before}
            after_by_id = {record["id"]: record for record in after}
            missing = sorted(
                f"{record['name']}/{record['type']}"
                for rid, record in before_by_id.items()
                if rid not in after_by_id
            )
            added = sorted(
                f"{record['name']}/{record['type']}"
                for rid, record in after_by_id.items()
                if rid not in before_by_id
            )
            modified = sorted(
                f"{before_by_id[rid]['name']}/{before_by_id[rid]['type']}"
                for rid in before_by_id.keys() & after_by_id.keys()
                if before_by_id[rid] != after_by_id[rid]
            )
            problems.append(
                "protected DNS changed: "
                f"missing={missing} added={added} modified={modified}"
            )
    return {
        "schema": "confenge.dns_cutover_verification/v1",
        "destination": destination,
        "ok": not problems,
        "protected_unchanged": protected_unchanged,
        "problems": problems,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("inventory", "plan", "apply", "verify"))
    parser.add_argument("--to", choices=tuple(TARGETS), help="destination host")
    parser.add_argument("--confirm", action="store_true", help="required by apply")
    parser.add_argument("--token-file")
    parser.add_argument("--evidence", type=Path, help="append the result as one NDJSON line")
    args = parser.parse_args(argv)

    try:
        token = _token(args)
        zone = zone_id(token)
        if args.command == "inventory":
            out = {
                "schema": "confenge.dns_inventory/v1",
                "zone": ZONE_NAME,
                "records": sorted((_slim(r) for r in records(token, zone)), key=lambda r: (r["type"], r["name"])),
            }
        elif args.command in ("plan", "apply"):
            if not args.to:
                raise CutoverError("--to is required")
            plan = build_plan(records(token, zone), args.to)
            if args.command == "plan":
                out = plan
            else:
                if not args.confirm:
                    raise CutoverError("apply requires --confirm")
                before = records(token, zone)
                expected_protected = _protected_snapshot(before)
                out = {
                    "plan": plan,
                    "applied": apply_plan(token, zone, plan),
                    "verification": verify(token, zone, args.to, expected_protected),
                }
        else:
            if not args.to:
                raise CutoverError("--to is required")
            out = verify(token, zone, args.to)
    except CutoverError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}), file=sys.stderr)
        return 1

    rendered = json.dumps(out, ensure_ascii=False, indent=2, sort_keys=True)
    print(rendered)
    if args.evidence:
        with args.evidence.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(out, ensure_ascii=False, sort_keys=True) + "\n")
    verification = out.get("verification") if isinstance(out, dict) else None
    if isinstance(verification, dict) and verification.get("ok") is False:
        return 2
    if isinstance(out, dict) and out.get("ok") is False:
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
