[Unit]
Description=CONFENGE portable inbound runtime
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/confenge-web/current

[Service]
Type=simple
User=confenge-deploy
Group=confenge-web
WorkingDirectory=/opt/confenge-web/current
Environment=NODE_ENV=production
Environment=RUNTIME_PROFILE=netcup-production
Environment=RUNTIME_HOST=127.0.0.1
Environment=RUNTIME_PORT=18100
Environment=CONFENGE_STORAGE_BACKEND=filesystem
Environment=CONFENGE_STORAGE_DIR=/var/lib/confenge-web
EnvironmentFile=/etc/confenge-web/runtime.env
ExecStart=/opt/confenge-web/bin/run-runtime
Restart=on-failure
RestartSec=2
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/confenge-web

[Install]
WantedBy=multi-user.target
