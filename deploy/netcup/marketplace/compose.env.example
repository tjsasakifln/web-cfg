# Private file on the host: /etc/confenge-marketplace/compose.env (mode 0600).
# Never run `docker compose config` without --quiet on the real credentials.
MARKETPLACE_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256_DIGEST
MARKETPLACE_RUNTIME_ENV=/etc/confenge-marketplace/runtime.env
MARKETPLACE_DB_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_BOOTSTRAP_SECRET
MARKETPLACE_DB_PASSWORD=REPLACE_WITH_UNIQUE_BASE64URL_SECRET
MARKETPLACE_REDIS_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_BASE64URL_SECRET
