[Unit]
Description=CONFENGE portable scheduled command %i
ConditionPathExists=/opt/confenge-web/shared/CUTOVER_SCHEDULES_AUTHORIZED
ConditionPathIsSymbolicLink=/opt/confenge-web/current
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=confenge-deploy
Group=confenge-deploy
WorkingDirectory=/opt/confenge-web/current
EnvironmentFile=-/etc/confenge-web/runtime.env
ExecStart=/opt/confenge-web/current/runtime/bin/run-schedule %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/confenge-web/shared
