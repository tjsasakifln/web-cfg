[Unit]
Description=CONFENGE portable scheduled command %i
ConditionPathExists=/opt/confenge-web/shared/schedule-cutover.json
ConditionPathIsSymbolicLink=/opt/confenge-web/current
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=confenge-deploy
Group=confenge-deploy
WorkingDirectory=/opt/confenge-web/current
Environment=NODE_ENV=production
Environment=RUNTIME_PROFILE=netcup-production
Environment=RUNTIME_HOST=127.0.0.1
Environment=RUNTIME_PORT=18100
Environment=CONFENGE_STORAGE_BACKEND=filesystem
Environment=CONFENGE_STORAGE_DIR=/var/lib/confenge-web
EnvironmentFile=/etc/confenge-web/runtime.env
ExecStart=/opt/confenge-web/bin/run-schedule %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/confenge-web/shared /var/lib/confenge-web
