{
  "name": "confenge-site",
  "private": true,
  "version": "1.0.0",
  "description": "CONFENGE static site — SEO migration and host canonization tooling",
  "type": "module",
  "scripts": {
    "prepare": "bash scripts/install-git-filters.sh",
    "test:release-filters": "python3 scripts/site/test_release_result_filters.py",
    "audit:migration": "node scripts/audit-migration.mjs",
    "audit:public-artifact": "python3 scripts/pseo/public_artifact.py audit",
    "validate:seo": "python3 seo/scripts/validate_seo.py",
    "test:analytics": "node seo/scripts/test_analytics_pii.mjs && node seo/scripts/test_editorial_analytics.mjs",
    "test:form-funnel": "node seo/scripts/test_form_funnel.mjs",
    "test:lead-function": "node scripts/site/test_lead_function.mjs",
    "test:secrets-scan": "node scripts/site/test_secrets_scan.mjs",
    "test:cta-whatsapp": "node scripts/site/test_cta_whatsapp.mjs",
    "probe:lead": "node scripts/site/synthetic_lead_probe.mjs",
    "probe:lead:prod": "node scripts/site/synthetic_lead_probe.mjs https://confenge.com.br",
    "test:pseo-attribution": "node seo/scripts/test_pseo_attribution.mjs",
    "test:structure": "python3 seo/scripts/test_criterion_structure.py",
    "test:brand": "python3 scripts/site/test_brand_contract.py",
    "test:design": "python3 scripts/site/test_design_gates.py",
    "test:copy": "python3 scripts/site/test_copy_gates.py",
    "test:visual-structure": "python3 scripts/site/test_design_gates.py",
    "test:ui": "node scripts/site/test_ui_geometry.mjs",
    "test:screenshots": "node scripts/site/capture_screenshots.mjs",
    "audit:performance": "python3 scripts/site/audit_performance.py",
    "audit:accessibility": "python3 scripts/site/audit_accessibility.py",
    "audit:axe": "node scripts/site/audit_axe.mjs",
    "build:site": "python3 scripts/pseo/build_site.py",
    "pseo:build": "python3 scripts/pseo/build.py",
    "pseo:validate": "python3 scripts/pseo/validate.py",
    "pseo:audit": "python3 scripts/pseo/audit.py && python3 scripts/pseo/editorial_audit.py",
    "pseo:audit:production": "python3 scripts/pseo/production_audit.py",
    "pseo:verify:release": "python3 scripts/pseo/verify_release.py",
    "pseo:gsc:ingest": "python3 scripts/pseo/gsc_ingest.py",
    "pseo:evidence:freeze-shas": "python3 scripts/pseo/freeze_shas.py",
    "pseo:prove-approval-stability": "python3 scripts/pseo/prove_approval_stability.py",
    "pseo:enrich-problem-service": "python3 scripts/pseo/enrich_problem_service.py",
    "pseo:test": "python3 -m pytest scripts/pseo/tests -q",
    "pseo:review": "python3 scripts/pseo/review.py",
    "test": "npm run pseo:test && npm run editorial:test && npm run test:analytics && npm run test:form-funnel && npm run test:lead-function && npm run test:secrets-scan && npm run test:cta-whatsapp && npm run test:pseo-attribution && npm run test:brand && npm run test:design && npm run test:copy && npm run test:ui && npm run test:inbound-gates",
    "pseo:editorial": "python3 scripts/pseo/editorial_audit.py",
    "editorial:build": "python3 scripts/editorial/build.py",
    "editorial:approve": "python3 scripts/editorial/approve_cli.py",
    "editorial:test": "python3 -m pytest scripts/editorial/tests -q",
    "pseo:learn": "python3 scripts/pseo/learn.py",
    "test:production-cutover": "node scripts/site/test_production_cutover.mjs",
    "test:production-cutover:local": "node scripts/site/test_production_cutover.mjs http://127.0.0.1:8765",
    "test:lighthouse": "node scripts/site/run_lighthouse.mjs",
    "audit:css-usage": "python3 scripts/site/audit_css_usage.py",
    "test:redirects": "node scripts/site/test_redirects.mjs",
    "test:redirects:prod": "node scripts/site/test_redirects.mjs https://confenge.com.br",
    "inbound:gates": "python3 scripts/site/inbound_gates.py --out docs/seo/INBOUND-GATES-REPORT.json",
    "inbound:remediate": "python3 scripts/site/inbound_first_remediate.py",
    "test:inbound-gates": "python3 scripts/site/test_inbound_gates.py",
    "editorial:truth": "python3 scripts/editorial/truth.py --write --fail-on-contradiction",
    "editorial:packet": "python3 -c \"print(\"use docs/editorial/WAVE1-HUMAN-REVIEW-PACKET.json\")\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^23.0.0"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11"
  }
}
