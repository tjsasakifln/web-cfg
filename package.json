{
  "name": "confenge-site",
  "private": true,
  "version": "1.0.0",
  "description": "CONFENGE static site — SEO migration and host canonization tooling",
  "type": "module",
  "scripts": {
    "prepare": "bash scripts/install-git-filters.sh",
    "test:release-filters": "python3 scripts/site/test_release_result_filters.py",
    "audit:migration": "node scripts/audit-migration.mjs",
    "audit:public-artifact": "python3 scripts/pseo/public_artifact.py audit",
    "validate:seo": "python3 seo/scripts/validate_seo.py",
    "test:analytics": "node seo/scripts/test_analytics_pii.mjs && node seo/scripts/test_editorial_analytics.mjs",
    "test:form-funnel": "node seo/scripts/test_form_funnel.mjs",
    "test:lead-function": "node scripts/site/test_lead_function.mjs",
    "test:secrets-scan": "node scripts/site/test_secrets_scan.mjs",
    "test:cta-whatsapp": "node scripts/site/test_cta_whatsapp.mjs",
    "probe:lead": "node scripts/site/synthetic_lead_probe.mjs",
    "probe:lead:prod": "node scripts/site/synthetic_lead_probe.mjs https://confenge.com.br",
    "test:pseo-attribution": "node seo/scripts/test_pseo_attribution.mjs",
    "test:structure": "python3 seo/scripts/test_criterion_structure.py",
    "test:brand": "python3 scripts/site/test_brand_contract.py",
    "test:design": "python3 scripts/site/test_design_gates.py && python3 scripts/site/test_visitor_redesign.py",
    "test:copy": "python3 scripts/site/test_copy_gates.py && python3 scripts/site/lint_editorial_copy.py --report docs/editorial/COPY-LINT-REPORT.json",
    "test:visual-structure": "python3 scripts/site/test_design_gates.py",
    "test:ui": "node scripts/site/test_ui_geometry.mjs",
    "test:screenshots": "node scripts/site/capture_screenshots.mjs",
    "audit:performance": "python3 scripts/site/audit_performance.py",
    "audit:accessibility": "python3 scripts/site/audit_accessibility.py",
    "audit:axe": "node scripts/site/audit_axe.mjs",
    "build:site": "python3 scripts/pseo/build_site.py",
    "pseo:build": "python3 scripts/pseo/build.py",
    "pseo:validate": "python3 scripts/pseo/validate.py",
    "pseo:audit": "python3 scripts/pseo/audit.py && python3 scripts/pseo/editorial_audit.py",
    "pseo:audit:production": "python3 scripts/pseo/production_audit.py",
    "pseo:verify:release": "python3 scripts/pseo/verify_release.py",
    "pseo:gsc:ingest": "python3 scripts/pseo/gsc_ingest.py",
    "pseo:evidence:freeze-shas": "python3 scripts/pseo/freeze_shas.py",
    "pseo:prove-approval-stability": "python3 scripts/pseo/prove_approval_stability.py",
    "pseo:enrich-problem-service": "python3 scripts/pseo/enrich_problem_service.py",
    "pseo:test": "python3 -m pytest scripts/pseo/tests -q",
    "pseo:review": "python3 scripts/pseo/review.py",
    "test": "npm run pseo:test && npm run editorial:test && npm run test:analytics && npm run test:form-funnel && npm run test:lead-function && npm run test:secrets-scan && npm run test:cta-whatsapp && npm run test:pseo-attribution && npm run test:brand && npm run test:design && npm run test:copy && npm run test:ui && npm run test:inbound-gates && npm run test:workflow-gates && npm run test:ops-docs && npm run test:revops && npm run test:schedules && npm run test:tools && npm run test:nurture && npm run test:nurture-pages && npm run test:ferramentas-footer && npm run test:hub-truth && npm run test:tool-compute && npm run test:wave1-fields && npm run test:lead-store-production && npm run test:ops-auth && npm run test:env-example && npm run test:epic-td && npm run test:script-modules",
    "pseo:editorial": "python3 scripts/pseo/editorial_audit.py",
    "editorial:build": "python3 scripts/editorial/build.py",
    "editorial:approve": "python3 scripts/editorial/approve_cli.py",
    "editorial:preview": "python3 scripts/editorial/preview.py --verify",
    "editorial:test": "python3 -m pytest scripts/editorial/tests -q",
    "pseo:learn": "python3 scripts/pseo/learn.py",
    "test:production-cutover": "node scripts/site/test_production_cutover.mjs",
    "test:production-cutover:local": "node scripts/site/test_production_cutover.mjs http://127.0.0.1:8765",
    "test:lighthouse": "node scripts/site/run_lighthouse.mjs",
    "audit:css-usage": "python3 scripts/site/audit_css_usage.py",
    "test:redirects": "node scripts/site/test_redirects.mjs",
    "test:redirects:prod": "node scripts/site/test_redirects.mjs https://confenge.com.br",
    "inbound:gates": "python3 scripts/site/inbound_gates.py --out docs/seo/INBOUND-GATES-REPORT.json",
    "inbound:remediate": "python3 scripts/site/inbound_first_remediate.py",
    "test:inbound-gates": "python3 scripts/site/test_inbound_gates.py",
    "test:workflow-gates": "python3 scripts/site/test_workflow_gates.py",
    "test:ops-docs": "python3 scripts/site/test_ops_docs_honesty.py",
    "editorial:truth": "python3 scripts/editorial/truth.py --fail-on-contradiction --require-packaged-live",
    "editorial:packet": "python3 -c \"print(\"use docs/editorial/WAVE1-HUMAN-REVIEW-PACKET.json\")\"",
    "editorial:truth:write": "python3 scripts/editorial/truth.py --write --fail-on-contradiction --require-packaged-live",
    "test:revops": "node scripts/revops/test_lead_stages.mjs && node scripts/revops/backfill_record_kind.mjs --local-fixture && python3 scripts/revops/test_search_demand.py",
    "test:schedules": "node scripts/revops/test_schedules.mjs",
    "revops:backfill-kind": "node scripts/revops/backfill_record_kind.mjs",
    "revops:backfill-kind:apply": "node scripts/revops/backfill_record_kind.mjs --apply",
    "revops:scheduled-daily": "node scripts/revops/scheduled_daily.mjs",
    "revops:scheduled-nurture": "node scripts/revops/scheduled_nurture.mjs",
    "revops:scheduled-weekly": "node scripts/revops/scheduled_weekly.mjs",
    "revops:gsc:sync": "python3 scripts/revops/search_demand_observatory.py sync --days 28 --reprocess-days 3",
    "revops:gsc:sync:fixture": "python3 scripts/revops/search_demand_observatory.py sync --fixture",
    "test:prod-build-info": "node scripts/site/test_prod_build_info.mjs",
    "revops:gsc:import": "python3 scripts/revops/search_demand_observatory.py import-csv --dir seo/gsc-2026-07-30",
    "revops:gsc:analyze": "python3 scripts/revops/search_demand_observatory.py analyze",
    "revops:gsc:pull": "python3 scripts/revops/search_demand_observatory.py pull-api --days 28",
    "revops:lead": "python3 scripts/revops/lead_cli.py",
    "test:entity-gone:prod": "node scripts/site/test_entity_gone_prod.mjs https://confenge.com.br",
    "test:ops-health": "node -e \"fetch('https://confenge.com.br/.netlify/functions/ops?action=health').then(r=>r.json()).then(j=>{if(!j.ok)process.exit(1);console.log(j)})\"",
    "test:tools": "node scripts/site/test_tools_structure.mjs && node scripts/site/test_tool_events.mjs",
    "revops:daily-health": "node scripts/revops/daily_health.mjs",
    "test:nurture": "node scripts/revops/test_nurture.mjs",
    "test:nurture-pages": "node scripts/site/test_nurture_pages.mjs",
    "test:ferramentas-footer": "python3 scripts/site/test_ferramentas_brand_footer.py",
    "test:hub-truth": "node scripts/site/test_hub_truth.mjs",
    "test:tool-compute": "node scripts/site/test_tool_compute.mjs",
    "test:wave1-fields": "node scripts/site/test_wave1_review_fields.mjs",
    "revops:daily": "node scripts/revops/revenue_daily.mjs",
    "revops:weekly-email": "node -e \"const t=process.env.OPS_TOKEN;if(!t){console.error(\"OPS_TOKEN required\");process.exit(1)};fetch((process.env.BASE_URL||\"https://confenge.com.br\")+\"/.netlify/functions/ops?action=weekly_email\",{method:\"POST\",headers:{Authorization:\"Bearer \"+t,\"Content-Type\":\"application/json\"},body:\"{}\"}).then(r=>r.json()).then(j=>{console.log(JSON.stringify(j));if(!j.ok)process.exit(1)})\"",
    "editorial:recommend": "python3 scripts/editorial/machine_recommend.py",
    "editorial:release-approved": "python3 scripts/editorial/release_approved.py",
    "pseo:pilot-audit": "python3 scripts/pseo/pilot_audit.py",
    "test:tool-events": "node scripts/site/test_tool_events.mjs",
    "lint:editorial-copy": "python3 scripts/site/lint_editorial_copy.py --report docs/editorial/COPY-LINT-REPORT.json",
    "test:tools-uiux-e2e": "node scripts/site/verify_tools_uiux_e2e.mjs docs/uiux-tools-remediation/evidence",
    "test:visitor-redesign": "python3 scripts/site/test_visitor_redesign.py",
    "test:stories-ready": "python3 scripts/site/test_stories_ready.py",
    "test:lead-store-production": "node scripts/site/test_lead_store_production_profile.mjs",
    "test:ops-auth": "node scripts/site/test_ops_auth_matrix.mjs",
    "test:env-example": "python3 scripts/site/test_env_example_honesty.py",
    "test:epic-td": "node scripts/site/test_epic_td_suite.mjs",
    "test:gsc-parity": "node scripts/revops/gsc_insights_sync.mjs --check",
    "test:script-modules": "node scripts/site/build_script_modules.mjs",
    "revops:export-leads": "node scripts/revops/export_leads.mjs",
    "revops:cohorts": "node scripts/revops/attribution_cohorts.mjs",
    "revops:dsar": "node scripts/revops/dsar_cli.mjs",
    "revops:gsc-sync": "node scripts/revops/gsc_insights_sync.mjs"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^23.0.0"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.11"
  }
}
