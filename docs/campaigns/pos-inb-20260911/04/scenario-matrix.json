      "expect": "changes_execution_measurement and asbuilt_handover_operations are EVIDENCE_PRESENT with applicability not_required_at_declared_stage"
    },
    {
      "id": "projeto_inexistente",
      "inputs": "design_set = nenhum",
      "expect_primary": null,
      "expect": "not labelled projeto defeituoso; not routed to revisão or elaboração; scope conversation"
    }
  ],
  "commands": [
    "node tests/pos-inb-20260911/04/test_scenario_matrix.mjs",
