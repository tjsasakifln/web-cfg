{
  "name": "confenge-bim",
  "version": "0.1.0",
  "private": true,
  "description": "Ferramentas de IFC e conferência de obras da CONFENGE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node scripts/servir-web.cjs",
    "test": "node --test tests/*.cjs tests/*.test.mjs",
    "build": "node scripts/preparar-web.cjs && node scripts/build-cad.cjs && node scripts/build-digitalizar.cjs && node scripts/build-modelagem.cjs && node scripts/build-oficina.cjs && node scripts/build-chapas.cjs && node scripts/build-fotogrametria.cjs && node scripts/avisos-canivete.cjs",
    "test:web": "node scripts/testar-navegador.mjs"
  },
  "dependencies": {
    "@ifc-lite/create": "5.1.3",
    "@ifc-lite/ids": "3.4.4",
    "@ifc-lite/parser": "9.9.0",
    "@node-projects/acad-ts": "3.8.0",
    "@tesseract.js-data/por": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "clipper-lib": "6.4.2",
    "copc": "0.0.9",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "laz-perf": "0.0.7",
    "occt-import-js": "0.0.23",
    "pdfjs-dist": "6.2.108",
    "replicad": "1.2.1",
    "replicad-opencascadejs": "1.2.1",
    "suncalc": "2.1.2",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "three": "0.180.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@mlightcad/libredwg-web": "0.8.4",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
