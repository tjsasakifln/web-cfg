+#[cfg(target_arch = "wasm32")]
+pub async fn acknowledge_prepared_exports<T>(
+    prepared: Result<(T, Vec<(String, Vec<u8>)>), String>,
+) -> Result<T, String> {
+    let (result, pending) = prepared?;
+    for (name, bytes) in pending {
+        download_bytes_async(&name, &bytes).await?;
+    }
