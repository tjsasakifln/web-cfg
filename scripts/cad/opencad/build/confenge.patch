+        .dyn_into::<js_sys::Promise>()
+        .map_err(|_| "A página não confirmou o pedido de exportação.".to_string())?;
+    let accepted = JsFuture::from(promise)
+        .await
+        .map_err(crate::io::web_recent::js_error)?;
+    if accepted.as_bool() != Some(true) {
+        return Err("Exportação cancelada. O desenho continua aberto e não foi salvo.".to_string());
     }
