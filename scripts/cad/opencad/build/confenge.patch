--- /dev/null
+++ b/scripts/build-confenge-web.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Modified CONFENGE edition, 2026-11-11. Distributed under GPL-3.0.
+set -eu
+cd "$(dirname "$0")/.."
+case "$(wasm-bindgen --version)" in
+  'wasm-bindgen 0.2.108') ;;
+  *) echo 'Use wasm-bindgen-cli 0.2.108 to match Cargo.lock.' >&2; exit 1 ;;
+esac
+out_dir=${CONFENGE_CAD_OUTPUT:-dist/confenge}
+mkdir -p "$out_dir/worker_pkg" "$out_dir/fonts"
+cargo build --locked --release --target wasm32-unknown-unknown --package ocs_web_worker
+cargo build --locked --release --target wasm32-unknown-unknown --bin OpenCADStudio
+wasm-bindgen --target web --out-dir "$out_dir" --out-name confenge-cad target/wasm32-unknown-unknown/release/OpenCADStudio.wasm
+wasm-bindgen --target web --out-dir "$out_dir/worker_pkg" --out-name ocs_web_worker target/wasm32-unknown-unknown/release/ocs_web_worker.wasm
+cp web/ocs-parse-worker.js web/ocs-control.js "$out_dir/"
+cp assets/confenge-logo.png "$out_dir/logo.png"
+cp web/fonts/*.ttf web/fonts/OFL.txt "$out_dir/fonts/"
+printf '%s\n' 'Assets ready. The hosting wrapper and export bridge are maintained in web-cfg/cad/editor.'
