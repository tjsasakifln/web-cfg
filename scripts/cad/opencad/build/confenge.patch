+    static HOST_EXPORT_CAPTURE: std::cell::RefCell<Option<Vec<(String, Vec<u8>)>>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// Run a synchronous exporter and acknowledge every file it produced before
+/// returning its success result to the app. A declined transaction aborts the
+/// completion, and a failed writer never sends partial output to the host.
+#[cfg(target_arch = "wasm32")]
+pub async fn with_acknowledged_exports<T, F>(work: F) -> Result<T, String>
+where
+    F: FnOnce() -> Result<T, String>,
+{
+    acknowledge_prepared_exports(prepare_acknowledged_exports(work)).await
+}
+
+/// Capture outputs synchronously so callers may borrow app state while
+/// preparing them, then hand the owned result to an asynchronous Task.
+#[cfg(target_arch = "wasm32")]
+pub fn prepare_acknowledged_exports<T, F>(
+    work: F,
+) -> Result<(T, Vec<(String, Vec<u8>)>), String>
+where
+    F: FnOnce() -> Result<T, String>,
+{
+    if HOST_EXPORT_CAPTURE.with(|capture| capture.borrow().is_some()) {
+        return Err("Outra exportação está sendo preparada. Tente novamente.".to_string());
+    }
+    HOST_EXPORT_CAPTURE.with(|capture| *capture.borrow_mut() = Some(Vec::new()));
+    let result = work();
+    let pending = HOST_EXPORT_CAPTURE.with(|capture| capture.borrow_mut().take().unwrap_or_default());
+    let result = result?;
+    Ok((result, pending))
+}
