        {
          "id": "choose_nucleus",
          "prompt_pt_br": "Onde voce iria se o problema fosse o seu, nao o nosso?"
        },
        {
          "id": "find_first_action",
          "prompt_pt_br": "Qual seria o primeiro passo concreto daqui?"
        },
        {
          "id": "use_canary_09",
          "prompt_pt_br": "Use o canario local da campanha 09 como se fosse o seu caso. O que acontece?"
        },
        {
          "id": "predict_triage_result",
          "prompt_pt_br": "Se voce enviasse esta triagem, o que espera que aconteca em seguida?"
        },
        {
          "id": "understand_credential_and_limit",
          "prompt_pt_br": "O que esta pagina diz que a CONFENGE pode e nao pode assumir?"
        },
        {
          "id": "distinguish_service_free_intel_formal_work",
          "prompt_pt_br": "O que aqui e servico, o que e inteligencia gratuita e o que e trabalho formal?"
        },
        {
          "id": "identify_b2g_without_feeling_removed",
          "prompt_pt_br": "Obras publicas ainda existem neste site? Como voce sabe?"
        },
        {
          "id": "evaluate_artifact_use",
          "prompt_pt_br": "Se voce recebesse este artefato, o que faria com ele amanha?"
        },
        {
          "id": "explain_internal_alternative",
          "prompt_pt_br": "Se nao contratasse ninguem, o que faria internamente?"
        },
        {
          "id": "react_to_price_only_when_published",
          "prompt_pt_br": "Se houver preco publicado nesta tela, o que ele comunica? Se nao houver, nao invente um preco."
        },
        {
          "id": "point_data_would_not_send_on_public_form",
          "prompt_pt_br": "Que dado desta situacao voce nao enviaria em um formulario publico?"
        }
