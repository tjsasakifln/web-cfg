        "note_pt_br": "Cada rota canônica de serviço vende uma unidade com preço e entra no censo sem edição manual da lista."
      },
      {
        "id": "money_example",
        "surface_class": "money_example",
        "from": "data/organic/public-family-registry.json#families[profile=priced_offer].match.prefix",
        "resolves_to": "expansão do prefixo contra os diretórios publicados que têm index.html",
        "note_pt_br": "Modelo novo publicado com preço passa a exigir linha de censo no mesmo commit."
      },
      {
        "id": "money_hub_priced",
        "surface_class": "money_hub",
        "from": "data/organic/public-family-registry.json#families[profile=priced_offer].match.routes",
