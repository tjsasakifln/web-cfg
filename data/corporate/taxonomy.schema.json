{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confenge.com.br/schema/confenge-corporate-taxonomy/v1",
  "title": "CONFENGE_CORPORATE_TAXONOMY",
  "description": "Machine-readable corporate taxonomy. Content authority is data/corporate/taxonomy.v1.json; this schema documents the shape. Python scripts/corporate_taxonomy/validate.py is the fail-closed gate. Do not add a jsonschema runtime dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "schema_id",
    "as_of",
    "decision_date",
    "owner_issue",
    "parent_issue",
    "producer",
    "content_sha256",
    "corporate_category",
    "public_identity",
    "owner_planes",
    "north_star",
    "addition_rules",
    "nuclei",
    "route_bindings",
    "b2g_coexistence"
  ],
  "properties": {
    "contract_id": { "const": "CONFENGE_CORPORATE_TAXONOMY" },
    "contract_version": { "const": "1.0.0-draft.20260904" },
    "schema_id": { "const": "confenge-corporate-taxonomy/v1" },
    "as_of": { "type": "string" },
    "decision_date": { "type": "string" },
    "owner_issue": { "const": 578 },
    "parent_issue": { "const": 577 },
    "producer": { "type": "object" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "corporate_category": { "type": "object" },
    "public_identity": { "type": "object" },
    "owner_planes": { "type": "object" },
    "north_star": { "type": "object" },
    "addition_rules": { "type": "object" },
    "nuclei": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "route_bindings": { "type": "array" },
    "b2g_coexistence": { "type": "object" },
    "sibling_contracts": { "type": "object" },
    "notes": { "type": "string" }
  }
}
