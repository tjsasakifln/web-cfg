{
  "schema": "confenge.robots-policy-baseline/v1",
  "decided_at": "2026-09-10",
  "decision_state": "EXECUTE_NOW",
  "authority": "Politica de rastreio vigente em confenge.com.br. Esta tabela e a EXPECTATIVA aprovada, derivada da politica e da configuracao, nao copiada da resposta que se deseja validar. Mudar a politica exige mudar este arquivo, sob revisao.",
  "managed_composition": {
    "enabled": true,
    "provider": "cloudflare-managed-robots",
    "begin_marker": "# BEGIN Cloudflare Managed content",
    "end_marker": "# END Cloudflare Managed Content",
    "note": "A caixa difere entre os marcadores: 'content' minusculo na abertura, 'Content' maiusculo no fechamento.",
    "why_kept": "O bloco gerenciado carrega politica que nao existe neste repositorio: Content-Signal search=yes,ai-train=no,use=reference e Disallow: / para os rastreadores de IA. Desligar a composicao para obter 'fonte unica' concederia silenciosamente treinamento de IA hoje negado -- mudanca de politica disfarcada de limpeza. A composicao e mantida de proposito, e o contrato de borda exige os bytes de origem integros.",
    "carries_policy": [
      "Content-Signal: search=yes,ai-train=no,use=reference"
    ]
  },
  "ai_crawlers_denied_everywhere": [
    "Amazonbot",
    "Applebot-Extended",
    "Bytespider",
    "CCBot",
    "ClaudeBot",
    "CloudflareBrowserRenderingCrawler",
    "Google-Extended",
    "GPTBot",
    "meta-externalagent"
  ],
  "private_surfaces_denied_to_every_agent": [
    "/ops/",
    "/intranet",
    "/.netlify/"
  ],
  "withdrawn_with_410_so_crawlers_can_see_the_gone": {
    "paths": [
      "/piloto/",
      "/panorama-mercado-obras-publicas/"
    ],
    "why": "Sobre uma URL retirada com 410 um Disallow seria MAIS FRACO, nao mais forte: impediria o rastreador de ver o 410 e de remover a URL do indice. A retirada com 410 e verificada pelas provas de URLs retiradas do proprio aceite."
  },
  "published_index_follow": {
    "paths": [
      "/analises-contratos-publicos/",
      "/analises-contratos-publicos/reajuste-incc-coluna-35-paralelepipedo-sao-goncalo-piaui-2026/"
    ],
    "why": "Uma analise foi aprovada e publicada com X-Robots-Tag: index, follow no _headers do pacote. O Allow correspondente e a condicao para que a decisao de indexar tenha efeito; sem ele a rota nunca chega a ser lida."
  },
