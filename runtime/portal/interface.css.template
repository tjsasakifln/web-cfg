:root {
  --paper: var(--white);
  --wash: var(--soft);
  --green: var(--green-700);
  --dark: var(--ink);
  --mint: var(--green-100);
  --portal-gutter: clamp(1rem, 3.2vw, 3rem);
  font-family: var(--sans);
  color: var(--ink);
  background: var(--white);
  line-height: 1.5;
}
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; }
[hidden] { display: none !important; }
h1, h2, h3, p { margin: 0; }
h1 { font-size: var(--text-h1); line-height: 1.1; letter-spacing: -0.025em; font-stretch: var(--wide); }
h2 { font-size: 1.2rem; line-height: 1.25; }
h3 { font-size: 1rem; }
a { color: var(--green); text-underline-offset: 0.2em; }
a:hover { text-decoration-thickness: 2px; }
button, input, select, textarea { font: inherit; }
:focus-visible {
  outline: 2px solid transparent;
  outline-offset: 2px;
  box-shadow: var(--focus-ring);
}
h1:focus, .portal-shell:focus, .result-count:focus { outline: none; box-shadow: none; }
.skip-link { position: absolute; top: -8rem; left: 1rem; z-index: 20; padding: 0.7rem 1rem; color: #102f21; background: #fff; }
.skip-link:focus { top: 0.6rem; }
.portal-shell { width: 100%; }
.startup { max-width: 42rem; margin: 0 auto; padding: clamp(1.25rem, 8vw, 5rem) 1.25rem; }
.startup p { margin: 0.7rem 0 1rem; color: var(--muted); }
.startup .eyebrow { margin: 0 0 0.5rem; color: var(--green); }
.recovery-page > form, .recovery-page > .button { margin-bottom: 1rem; }
.startup-links, .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem 1rem; }
.portal-masthead {
  padding-inline: var(--portal-gutter);
  background: var(--navy-900);
  color: var(--white);
  --focus-ring-halo: var(--navy-900);
  --focus-ring-core: var(--lime);
}
.portal-masthead__inner, .portal-masthead .nav {
  width: min(100%, var(--container));
  margin-inline: auto;
}
.portal-masthead__inner {
  display: flex;
  align-items: center;
  min-height: 73px;
  gap: clamp(.45rem, 1.8vw, 1rem);
}
.portal-wordmark { display: block; max-width: 50%; min-width: 0; }
.portal-wordmark img { display: block; max-width: 100%; width: 172px; height: auto; }
.return-site, .masthead-help {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  gap: .25rem;
  color: var(--white);
  font-size: var(--text-small);
  font-weight: 650;
}
.return-site { margin-left: auto; }
.return-site span { color: var(--lime); }
.login {
  width: min(calc(100% - 2 * var(--portal-gutter)), 66rem);
  margin-inline: auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
  align-items: start;
  column-gap: clamp(2rem, 6vw, 6.5rem);
  padding-block: clamp(2.25rem, 6vw, 5rem);
}
.login__brand { min-width: 0; }
.login-intro h1 { margin: .4rem 0 .6rem; }
.login-intro p:not(.eyebrow) { color: var(--text); max-width: 39ch; font-size: var(--text-lead); }
.login-topics { margin: 1.65rem 0 0; border-top: 1px solid var(--rule-strong); }
.login-topics div { padding: .75rem 0; border-bottom: 1px solid var(--rule); }
.login-topics dt { font-weight: 720; }
.login-topics dd { margin: .18rem 0 0; color: var(--muted); font-size: var(--text-small); }
.login__content { min-width: 0; }
.login-card, .startup {
  width: 100%;
  background: var(--paper);
  border: 1px solid var(--line);
  border-top-color: var(--rule-strong);
  border-radius: var(--radius-md);
}
.login-card { padding: clamp(1rem, 2.8vw, 1.75rem); }
.startup { width: min(calc(100% - 2 * var(--portal-gutter)), 32rem); margin-top: clamp(1rem, 5vw, 3.5rem); padding: clamp(1rem, 3.8vw, 1.9rem); }
.login-card h2 { font-size: var(--text-h3); letter-spacing: -.02em; font-stretch: var(--wide); }
.login-lead { margin: .35rem 0 1rem; color: var(--muted); font-size: var(--text-small); }
.login-card .button { margin-bottom: .25rem; }
.login-submit { width: 100%; }
.eyebrow { font-size: var(--text-micro); letter-spacing: .1em; text-transform: uppercase; color: var(--green); font-weight: 760; font-stretch: var(--narrow); }
.field { min-width: 0; margin-bottom: 0.95rem; }
.field label { display: grid; gap: 0.35rem; font-size: 0.9rem; font-weight: 680; }
.field > label[for] { margin-bottom: 0.35rem; }
input:not([type="checkbox"]), select, textarea {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  border: 1px solid #8796a7;
  border-radius: var(--radius-md);
  background: #fff;
  padding: 0.6rem 0.7rem;
  color: var(--ink);
  font-weight: 400;
  font-size: 1rem;
}
textarea { min-height: 110px; resize: vertical; }
.password-wrap { position: relative; }
.password-wrap input { padding-right: 5.5rem; }
.password-wrap .password-toggle {
  position: absolute; right: 1px; top: 1px; bottom: 1px;
  min-height: 42px; padding: 0.3rem 0.65rem; color: var(--green); background: var(--mint);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
}
.access-guide { border-top: 1px solid var(--rule); margin-top: .6rem; padding-top: .2rem; font-size: var(--text-small); }
.access-guide summary { cursor: pointer; font-weight: 710; min-height: 44px; padding: .62rem 0; }
.access-guide p { color: var(--muted); }
.access-help { display: grid; justify-items: start; align-items: start; margin-top: .35rem; }
.access-help a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 680; }
.access-note { font-size: var(--text-micro); }
.button {
  min-height: 44px;
  flex: 0 0 auto;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  padding: 0.55rem 0.87rem;
  font-weight: 710;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 0.4rem;
  line-height: 1.25;
  text-align: center;
}
.button:disabled { opacity: 0.58; cursor: wait; }
.button--text { color: var(--green); background: none; text-decoration: underline; padding-inline: 0; }
.button--primary { background: var(--green); color: #fff; }
.button--primary:hover:not(:disabled) { background: var(--navy-800); }
.button--soft { background: var(--mint); color: var(--dark); }
.button--line { background: transparent; border-color: #7e8da0; color: var(--dark); }
.button--line:hover:not(:disabled), .button--soft:hover:not(:disabled) { background: var(--soft); }
.form-note { margin: 0.45rem 0 0.85rem; font-size: 0.87rem; color: var(--muted); }
.flash { margin: 0.2rem 0 0.9rem; border: 1px solid #ecc2c2; border-radius: 8px; padding: 0.65rem 0.8rem; background: #fff0ef; color: #782424; font-size: 0.92rem; }
.app { min-height: 100vh; }
.account {
  color: var(--white);
  margin-left: auto;
  min-width: 0;
  font-size: var(--text-small);
  font-weight: 720;
  overflow-wrap: anywhere;
}
.masthead-help { color: var(--white); }
.portal-masthead .button--line { color: var(--white); border-color: #8796a7; }
.portal-masthead .button--line:hover:not(:disabled) { background: var(--navy-800); }
.portal-masthead .nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0 1.35rem;
  border-top: 1px solid #465971;
}
.nav a {
  min-width: 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  color: inherit;
  font-size: var(--text-small);
  font-weight: 690;
  line-height: 1.2;
  text-decoration: none;
  border-bottom: 3px solid transparent;
  padding: .33rem 0;
  overflow-wrap: anywhere;
}
.nav a:hover { text-decoration: underline; }
.nav a[aria-current="page"] { color: var(--lime); border-color: currentColor; }
.content { width: min(100%, calc(var(--container) + 2 * var(--portal-gutter))); margin: 0 auto; padding: clamp(.9rem, 2.5vw, 2rem) var(--portal-gutter) 2.5rem; min-width: 0; }
.workspace-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 0.65rem; margin-bottom: 0.6rem; }
.refresh-button { font-size: 0.85rem; }
.app-feedback:empty, .dialog-status:empty { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); padding: 0; margin: 0; }
.app-feedback, .dialog-status, .next-step { background: var(--mint); color: #14392a; border-radius: 8px; font-size: 0.9rem; padding: 0.65rem 0.8rem; margin-bottom: 0.8rem; overflow-wrap: anywhere; }
#portal-view { display: grid; gap: 1.1rem; min-width: 0; }
.welcome, .page-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-width: 0; }
.welcome {
  color: var(--ink);
  background: var(--soft);
  border: 1px solid var(--line);
  border-top-color: var(--rule-strong);
  border-radius: var(--radius);
  padding: clamp(1rem, 3.35vw, 2.2rem);
}
.welcome h1 { margin: 0.35rem 0 0.55rem; }
.welcome p:not(.eyebrow), .page-heading p { color: var(--muted); max-width: 58ch; }
.page-heading p { margin-top: 0.45rem; }
.recovery-reminder { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.6rem 1rem; padding: 0.8rem 1rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
.recovery-reminder h2 { font-size: 1rem; }
.recovery-reminder p { font-size: 0.9rem; margin-top: 0.22rem; color: var(--muted); }
.recovery-reminder .button { flex: 0 1 auto; }
.attention { display: flex; align-items: center; gap: 0.5rem 0.85rem; flex-wrap: wrap; padding: 0.75rem 1rem; background: #fff5de; border: 1px solid #ead8a7; border-radius: var(--radius); }
.attention h2 { font-size: 1rem; }
.attention .button { background: #fffdf6; border-color: #aa925a; flex: 0 1 auto; text-align: left; }
.quickstart h2 { margin-bottom: 0.6rem; }
.task-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
.task-card {
  display: grid; grid-template-columns: auto 1fr; align-content: start; gap: 0.45rem 0.6rem;
  min-width: 0; padding: 1rem;
  border: 1px solid var(--line); border-radius: var(--radius);
  background: var(--paper); color: var(--ink); text-decoration: none;
}
.task-card:hover { border-color: var(--green); background: var(--soft); }
.task-card:hover strong { text-decoration: underline; text-underline-offset: 0.16em; }
.task-icon { display: grid; place-items: center; color: var(--green); background: var(--mint); border-radius: 8px; width: 2.1rem; height: 2.1rem; font-weight: 800; }
.task-card strong { align-self: center; }
.task-card span:not(.task-icon), .task-card small { grid-column: 1/-1; font-size: 0.88rem; color: var(--muted); }
.task-card small { color: var(--green); font-weight: 720; margin-top: 0.15rem; }
.grid { display: grid; gap: 0.85rem; }
.split { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: start; }
.card { min-width: 0; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(0.85rem, 2vw, 1.25rem); }
.section-head { display: flex; gap: 0.65rem; justify-content: space-between; align-items: start; margin-bottom: 0.75rem; }
.section-head p, .empty { margin-top: 0.35rem; font-size: 0.92rem; color: var(--muted); }
.item-list, .ticket-list, .doc-list { display: grid; gap: 0.48rem; min-width: 0; }
.ticket {
  display: flex; justify-content: space-between; align-items: start; width: 100%; min-height: 44px;
  gap: 0.65rem; text-align: left; background: #fff; border: 1px solid var(--line);
  color: var(--ink); border-radius: 10px; padding: 0.7rem; cursor: pointer;
}
.ticket:hover { background: #f3faf6; border-color: #81ad94; }
.ticket__main, .file-info { min-width: 0; overflow-wrap: anywhere; }
.ticket__main span, .file-info span, .message small { display: block; color: var(--muted); font-size: 0.8rem; margin-top: 0.13rem; }
.ticket__signals { flex-shrink: 0; display: grid; justify-items: end; gap: 0.15rem; }
.badge { font-size: 0.74rem; font-weight: 700; padding: 0.16rem 0.45rem; border-radius: 0.7rem; background: #edf2ef; color: #415249; }
.badge--aberto { background: #e4f1ff; color: #15577f; }
.badge--em_analise { background: #fff0d2; color: #804e00; }
.badge--aguardando_cliente { background: #f4e7ff; color: #632d7c; }
.badge--concluido { background: #def1e5; color: #16603d; }
.unread-label { font-size: 0.74rem; font-weight: 730; color: #8c400c; }
.file-row { display: flex; justify-content: space-between; align-items: center; gap: 0.7rem; border-bottom: 1px solid var(--line); padding: 0.54rem 0; }
.file-row:last-child { border-bottom: 0; }
.toolbar, .pagination, .status-row { display: flex; align-items: end; flex-wrap: wrap; gap: 0.6rem 0.85rem; margin-bottom: 0.55rem; }
.toolbar .field { flex: 1 1 10rem; max-width: 22rem; margin-bottom: 0; }
.check-filter { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; font-size: 0.9rem; cursor: pointer; }
.check-filter input { width: 1.2rem; height: 1.2rem; accent-color: var(--green); }
.result-count { margin: 0.45rem 0 0.75rem; color: var(--muted); font-size: 0.88rem; }
.opportunity-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; padding: 0; list-style: none; margin: 0; }
.opportunity { display: flex; flex-direction: column; min-width: 0; gap: 0.65rem; border: 1px solid var(--line); border-radius: 12px; padding: 0.85rem; overflow-wrap: anywhere; }
.opportunity h2 { font-size: 1rem; }
.opportunity dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 0.6rem; margin: 0; }
.opportunity dt { color: var(--muted); font-size: 0.75rem; font-weight: 690; }
.opportunity dd { margin: 0; font-size: 0.88rem; }
.opportunity .actions { margin-top: auto; padding-top: 0.25rem; }
.opportunity .button { flex: 0 1 auto; font-size: 0.89rem; }
.pagination { align-items: center; justify-content: center; padding-top: 0.8rem; }
.has-dialog { overflow: hidden; }
.dialog { position: fixed; inset: 0; background: #031020aa; z-index: 30; padding: 0.8rem; display: grid; place-items: center; }
.dialog__card {
  width: min(100%, 42.5rem);
  max-height: calc(100vh - 1.6rem);
  max-height: calc(100dvh - 1.6rem);
  overflow: auto;
  overscroll-behavior: contain;
  background: #fff;
  border-radius: var(--radius);
  padding: clamp(0.9rem, 3vw, 1.45rem);
  box-shadow: 0 16px 40px #0004;
}
.dialog__head { display: flex; justify-content: space-between; gap: 0.75rem; align-items: center; margin-bottom: 0.6rem; }
.dialog__head h2 { overflow-wrap: anywhere; }
.close { flex: 0 0 44px; min-height: 44px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: #fff; font-size: 1.35rem; cursor: pointer; }
.ticket-context { margin-bottom: 0.8rem; font-size: 0.87rem; color: var(--muted); overflow-wrap: anywhere; }
.messages { display: grid; gap: 0.55rem; margin: 0.55rem 0 1.1rem; }
.message { justify-self: start; max-width: min(95%, 36rem); border-radius: 10px; padding: 0.65rem 0.85rem; background: #eef2f0; overflow-wrap: anywhere; }
.message > div { white-space: pre-wrap; }
.message--own { justify-self: end; background: var(--mint); }
.message-form { margin-top: 0.85rem; }
.message-form .field { margin-bottom: 0.6rem; }
.dialog-status { margin: 0.6rem 0 0.1rem; }
.status-row select { flex: 1 1 10rem; width: auto; }
.upload-zone { border: 1px dashed #8aa996; border-radius: 10px; padding: 0.75rem; background: #f5fbf7; margin-bottom: 0.8rem; }
.admin-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }

@media (max-width: 800px) {
  .login { width: min(calc(100% - 2 * var(--portal-gutter)), 30rem); grid-template-columns: 1fr; gap: 1.1rem; padding-block: 1.3rem 2rem; }
  .login-intro h1 { margin: .25rem 0 .3rem; }
  .login-intro p:not(.eyebrow) { font-size: 1rem; }
  .login-topics { display: none; }
  .portal-masthead__inner { min-height: 64px; }
  .portal-wordmark img { width: 144px; }
}
@media (max-width: 640px) {
  .portal-masthead .nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 .45rem; }
  .nav a { font-size: .8rem; }
  .workspace-tools { gap: .35rem; }
  .recovery-reminder > * { min-width: 0; max-width: 100%; }
}
@media (max-width: 375px) {
  .workspace-masthead .portal-wordmark img { width: 112px; }
  .masthead-help, .account { font-size: .8rem; }
}
@media (max-width: 600px) {
  .welcome, .page-heading { flex-wrap: wrap; align-items: start; }
  .welcome > .button, .page-heading > .button { flex: 1 1 100%; }
  .task-grid, .split, .opportunity-list { grid-template-columns: 1fr; }
  .task-grid { gap: 0.5rem; }
  .task-card { grid-template-columns: auto 1fr; gap: 0.2rem 0.65rem; padding: 0.65rem 0.72rem; }
  .task-icon { grid-row: 1/4; }
  .task-card span:not(.task-icon), .task-card small { grid-column: 2; }
  .ticket { display: grid; gap: 0.3rem; }
  .ticket__signals { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .section-head { flex-wrap: wrap; }
}
@media (forced-colors: active) {
  :focus-visible { box-shadow: none; outline-color: Highlight; }
  .nav a[aria-current="page"] { border-color: Highlight; }
}

/* Tipografia oficial e componentes do radar privado da Extra. */
@font-face {
  font-family: "Archivo Var";
  src: url("/assets/archivo-var-latin-b19be0f7.woff2") format("woff2-variations");
  font-style: normal;
  font-weight: 100 900;
  font-stretch: 78% 100%;
  font-display: swap;
}
.app--extra-intelligence .workspace-tools { display: none; }
.extra-intel { display: grid; gap: 1rem; min-width: 0; line-height: 1.48; --extra-ink: var(--ink); --extra-muted: var(--muted); --extra-action: var(--green-700); --extra-line: var(--rule); }
.extra-intel .eyebrow { color: var(--extra-action); font-stretch: var(--narrow); }
.extra-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: .8rem 1.5rem; }
.extra-head h1 { color: var(--extra-ink); font-size: var(--text-h1); margin: .24rem 0 .38rem; font-stretch: var(--wide); }
.extra-head > div:first-child > p:last-child { font-size: var(--text-lead); max-width: 65ch; color: var(--extra-muted); }
.extra-source { border-left: 1px solid var(--rule-strong); padding-left: .8rem; color: var(--extra-muted); font-size: var(--text-small); }
.extra-source strong { display: block; color: var(--extra-ink); }
.extra-scope { border-block: 1px solid var(--extra-line); border-top-color: var(--rule-strong); display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; padding: .55rem 0; font-size: var(--text-small); }
.extra-scope strong { color: var(--extra-action); }
.extra-scope p { color: var(--extra-muted); }
.extra-scope label { display: flex; align-items: center; gap: .45rem; }
.extra-scope select { width: auto; font-size: var(--text-small); min-height: 36px; padding: .2rem .45rem; border: 1px solid #8b9bad; border-radius: var(--radius-sm); }
.extra-view-nav { display: flex; flex-wrap: wrap; gap: .1rem 1.25rem; border-bottom: 1px solid var(--extra-line); }
.extra-view-nav button { background: transparent; border: 0; border-bottom: 3px solid transparent; min-height: 44px; padding: .15rem 0; color: var(--extra-muted); font-weight: 700; cursor: pointer; font-size: var(--text-small); }
.extra-view-nav button[aria-current="page"] { border-bottom-color: var(--extra-action); color: var(--extra-ink); }
.extra-panel, .extra-intel section { display: grid; gap: .7rem; min-width: 0; }
.extra-intel h2 { font-size: var(--text-h2); font-stretch: var(--wide); letter-spacing: -.023em; }
.extra-intel h3 { font-size: var(--text-h3); font-stretch: var(--wide); letter-spacing: -.015em; }
.extra-section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: .6rem 1rem; }
.extra-note { font-size: var(--text-small); color: var(--extra-muted); }
.extra-action, .extra-link {
  color: var(--extra-ink); border: 1px solid var(--rule-strong); border-radius: var(--radius-md);
  min-height: 40px; padding: .36rem .68rem; background: var(--white); font-weight: 730; font-size: var(--text-small);
  cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; width: fit-content;
}
.extra-action:disabled { opacity: .6; cursor: wait; }
.extra-link { border: 0; border-bottom: 1px solid var(--rule-strong); border-radius: 0; padding: 0; min-height: 24px; }
.extra-action--primary { background: var(--green-700); border-color: var(--green-700); color: var(--white); }
.extra-data { width: 100%; border-collapse: collapse; border-top: 1px solid var(--rule-strong); font-size: var(--text-data); }
.extra-data :is(th,td) { text-align: left; border-bottom: 1px solid var(--extra-line); padding: .55rem .65rem; vertical-align: top; }
.extra-data th { background: var(--soft); color: var(--extra-muted); font-size: var(--text-micro); text-transform: uppercase; letter-spacing: .07em; font-stretch: var(--narrow); }
.extra-data td strong, .extra-data td small { display: block; }
.extra-data td small { color: var(--extra-muted); font-size: var(--text-micro); margin-block-start: .18rem; }
.extra-data tr:first-child td:first-child { border-inline-start: 3px solid var(--extra-action); background: var(--green-100); }
.extra-coverage, .extra-intel details { border-top: 1px solid var(--rule-strong); background: var(--soft); padding: .75rem .9rem; font-size: var(--text-small); }
.extra-coverage p + p { margin-top: .42rem; }
.extra-intel summary { font-weight: 730; cursor: pointer; padding-block: .26rem; }
.extra-intel .extra-evidence { list-style: none; padding: 0; margin: 0; }
.extra-evidence li { padding: .6rem 0; border-bottom: 1px solid var(--extra-line); }
.extra-evidence a, .extra-data a { color: var(--extra-ink); font-weight: 720; overflow-wrap: anywhere; }
.extra-chart { display: grid; gap: .35rem; border-top: 1px solid var(--rule-strong); padding: .7rem; background: var(--soft); }
.extra-axis { display: grid; grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr)); padding: 0; list-style: none; }
.extra-axis li { border-top: 2px solid var(--navy-800); padding: .48rem .3rem .05rem; font-size: var(--text-small); }
.extra-axis li:last-child { border-top: 2px dashed var(--green-700); }
.extra-axis strong, .extra-axis small { display: block; }
.extra-axis small { color: var(--extra-muted); }
.extra-pagination { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
@media (max-width: 650px) {
  .extra-head { grid-template-columns: 1fr; }
  .extra-scope label { flex-wrap: wrap; }
  .extra-view-nav { gap: 0 .85rem; }
  .extra-view-nav button { font-size: .8rem; }
  .extra-data, .extra-data tbody, .extra-data tr, .extra-data td { display: block; width: 100%; }
  .extra-data thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .extra-data tr { padding: .48rem .6rem; border-bottom: 1px solid var(--extra-line); }
  .extra-data td { border: 0; padding: .22rem .1rem; overflow-wrap: anywhere; }
  .extra-data td:not(:first-child)::before { content: attr(data-label); display: block; font-size: var(--text-micro); color: var(--extra-muted); }
  .extra-data tr:first-child { border-inline-start: 3px solid var(--extra-action); background: var(--green-100); }
  .extra-data tr:first-child td:first-child { border: 0; }
}
