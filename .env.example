# ============================================
# CONFENGE product environment (static + Netlify functions)
# ============================================
# Copy to `.env` for local tools. NEVER commit real secrets.
# Source of truth for names: docs/ops/ENV-VARS.md
# ============================================

# --------------------------------------------
# Product / Leads / Ops (CONFENGE runtime)
# --------------------------------------------

# Ops auth (required for sensitive ops actions in production)
OPS_TOKEN=
REVOPS_TOKEN=

# Durable dynamic storage. Netcup production must use an absolute, pre-created
# 0700 directory outside the release. Netlify uses the legacy adapter only
# during the rollback window.
CONFENGE_STORAGE_BACKEND=
CONFENGE_STORAGE_DIR=
# Deprecated local/dev compatibility alias; do not use for new production.
LEAD_STORE_DIR=
# test-only: memory — forbidden in production profile
LEAD_STORE=
# DANGEROUS — never set in production / CONTEXT=production
LEAD_ALLOW_MEMORY_FALLBACK=

# Optional HTTP store for local/dev integration only. Generic GET-then-POST
# cannot guarantee atomic create-only writes and is blocked in production.
LEAD_STORE_HTTP_URL=
LEAD_STORE_HTTP_TOKEN=
LEAD_STORE_HTTP_GET_IDEMPOTENCY_URL=

# Netlify Blobs (when Lambda context unavailable)
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
NETLIFY_API_TOKEN=
NETLIFY_AUTH_TOKEN=
NETLIFY_BLOBS_CONTEXT=
SITE_ID=
NETLIFY_SITE_ID=
CONTEXT=
NODE_ENV=

# Portable runtime. Local defaults to 127.0.0.1:8787. Netcup production is
# launched with the explicit host-owned contract 127.0.0.1:18100; release SHA,
# timestamps and artifact hashes are derived from immutable manifests.
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=
RUNTIME_PROFILE=

# Notifications
OPS_WEBHOOK_URL=
OPS_WEBHOOK_SECRET=
OPS_WEBHOOK_BEARER=
OPS_WEBHOOK_ALLOWED_HOSTS=

# Warmbly inbound handoff (server→server; never the Slack-style OPS_WEBHOOK_*)
# Contract: Warmbly PR #71 docs/confenge/inbound-ingest.md
# Capture still succeeds if these are empty. HTTPS + host fail-closed in staging/prod.
CONFENGE_INBOUND_WEBHOOK_URL=https://api.confenge.com.br/api/v1/webhooks/confenge/inbound
CONFENGE_INBOUND_WEBHOOK_SECRET=
CONFENGE_INBOUND_ALLOWED_HOSTS=
CONFENGE_INBOUND_MAX_ATTEMPTS=
CONFENGE_INBOUND_TIMEOUT_MS=
# Cross-system commercial_event.v1 producer. Default off. HMAC secret server-side only.
CONFENGE_COMMERCIAL_EVENT_ENABLED=
CONFENGE_COMMERCIAL_EVENT_WEBHOOK_URL=
CONFENGE_COMMERCIAL_EVENT_WEBHOOK_SECRET=
CONFENGE_COMMERCIAL_EVENT_HEALTH_URL=
CONFENGE_COMMERCIAL_EVENT_ALLOWED_HOSTS=
CONFENGE_COMMERCIAL_EVENT_TIMEOUT_MS=
RESEND_API_KEY=
NURTURE_RATE_WINDOW_MS=
NURTURE_RATE_MAX_IP=
NURTURE_RATE_MAX_FP=
NURTURE_TOKEN_SECRET=
NURTURE_TOKEN_SECRET_PREVIOUS=
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
NTFY_URL=
NTFY_TOKEN=
NTFY_TOPIC=
NTFY_ALLOWED_HOSTS=

# Abuse / privacy
TURNSTILE_SECRET_KEY=
# Public key required by the production build; injected only into _site.
TURNSTILE_SITE_KEY=
# Required in production: both guards must be 1, with a real Turnstile secret.
LEAD_REQUIRE_TURNSTILE=
LEAD_PROBE_SECRET=
LEAD_REQUIRE_ORIGIN=
LEAD_RETAIN_DAYS=730
ANALYTICS_RETAIN_DAYS=90
NURTURE_RETAIN_DAYS=730
CORRECTION_RETAIN_DAYS=730
COMMERCIAL_EVENT_RETAIN_DAYS=730
SEARCH_OBSERVATION_RETAIN_DAYS=730
LEAD_RATE_WINDOW_MS=
LEAD_RATE_MAX_IP=
LEAD_RATE_MAX_FP=
# Required in production: private random value with at least 32 characters.
IP_HASH_SALT=
ALLOWED_ORIGINS=

# Analytics is first-party at /.netlify/functions/collect.
# Third-party export is DEFER (#247) and has no environment-only enable switch.

# Ops tooling
OPS_BASE=https://confenge.com.br
BASE_URL=https://confenge.com.br
GSC_BACKUP_DIR=

# Search Console (read-only). Never commit the JSON.
# Property: sc-domain:confenge.com.br
# Scope: https://www.googleapis.com/auth/webmasters.readonly
GSC_SITE_URL=sc-domain:confenge.com.br
GSC_CREDENTIALS_JSON=
GSC_CLIENT_SECRETS_JSON=
GSC_TOKEN_JSON=
GSC_USE_FIXTURE=

# Build / release (usually injected by Netlify)
COMMIT_REF=
CACHED_COMMIT_REF=

# --------------------------------------------
# NON-PRODUCT / AIOX framework only (optional)
# Not used by the public Netlify CONFENGE site runtime.
# --------------------------------------------

# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EXA_API_KEY=
# CONTEXT7_API_KEY=
# GITHUB_TOKEN=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
