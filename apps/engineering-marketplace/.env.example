# Private backend example. Never copy this file to the public site artifact.
# Generate unique production values with deploy/netcup/marketplace/init-config.py.
NODE_ENV=production
MEDUSA_DISABLE_TELEMETRY=true
MERCUR_DISABLE_TELEMETRY=true
DO_NOT_TRACK=1
MEDUSA_WORKER_MODE=server
DATABASE_URL=postgresql://marketplace:REPLACE_DATABASE_PASSWORD@postgres:5432/marketplace
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
JWT_SECRET=REPLACE_WITH_UNIQUE_32_BYTE_SECRET
COOKIE_SECRET=REPLACE_WITH_ANOTHER_UNIQUE_32_BYTE_SECRET
MARKETPLACE_GATEWAY_KEY=REPLACE_WITH_UNIQUE_BASE64URL_OR_HEX_SECRET
MARKETPLACE_PUBLIC_ORIGIN=https://confenge.com.br
BACKEND_URL=https://confenge.com.br

# Keep checkout/onboarding disabled until the recorded acceptance procedure.
MARKETPLACE_PAYMENTS_ENABLED=false
MARKETPLACE_PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_OPERATOR_WEBHOOK_SECRET=
STRIPE_SELLERS_WEBHOOK_SECRET=

# Explicit commercial decision in basis points, 0..5000. Omission blocks quotes.
# MARKETPLACE_COMMISSION_BPS=REPLACE_WITH_APPROVED_INTEGER

# Optional: copy the dedicated pk_ returned by setup for the private readiness
# probe. The API itself obtains its publishable key from the caller's header.
MARKETPLACE_READINESS_PUBLISHABLE_KEY=
